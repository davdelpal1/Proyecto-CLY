{
  "name": "@cly/game",
  "version": "0.1.0",
  "private": true,
  "description": "App universal Expo (web + iOS + Android) de Proyecto CLY.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cly/design-tokens": "workspace:*",
    "@cly/game-engine": "workspace:*",
    "@cly/numbers-engine": "workspace:*",
    "@cly/words-engine": "workspace:*",
    "@expo/log-box": "~58.0.13",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4"
  }
}
