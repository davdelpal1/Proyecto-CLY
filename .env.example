# Copiar a .env.local (apps/game) o .env (servicios). Nunca subir secretos.
#
# Sprint 1: la app de juego NO necesita ninguna variable. Los modos de entrenamiento
# funcionan sin backend, sin cuenta y sin red. Las variables siguientes quedan
# reservadas para tickets posteriores y están vacías a propósito.

# --- apps/game (solo variables públicas, prefijo EXPO_PUBLIC_) ---
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_REALTIME_URL=

# --- apps/api / apps/realtime (futuro; CLY-013, CLY-050) ---
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # SOLO servidor; jamás en la app móvil
